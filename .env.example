# Copy to .env (never commit .env). The server reads these; nothing is exposed to the browser.

# Required for LIVE LLM-driven agents (Claude runtime). Without it, agents can still run
# real scripted workloads (NEXUS TEST LAB) and the orchestrator uses a heuristic planner.
ANTHROPIC_API_KEY=

# Default model for agents/orchestrator (override per role in the UI).
NEXUS_DEFAULT_MODEL=claude-opus-5-5

# HTTP/WebSocket port for the backend.
NEXUS_PORT=4317

# Where projects, git repos, worktrees and the SQLite DB live.
NEXUS_DATA_DIR=./.nexus

# Command executor: "local" (sandboxed child processes) or "docker" (requires a running Docker daemon).
NEXUS_EXECUTOR=local
